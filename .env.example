# Copy to .env.production (or set these in your host's dashboard). All are public:
# anything prefixed VITE_ is embedded in the browser bundle, so never put secrets here.

# REQUIRED: the live https origin, no trailing slash. Used for canonical URLs, sitemap, robots, structured data.
VITE_SITE_URL=https://www.your-domain.in

# REQUIRED (at least one of the next two) so enquiries actually reach the business:
# a form endpoint that accepts JSON POSTs (e.g. a Formspree form URL)...
VITE_LEAD_ENDPOINT=
# ...and/or a WhatsApp number: country code + number, digits only, e.g. 919876543210
VITE_WHATSAPP_NUMBER=

# Strongly recommended: shown in the footer/contact section and structured data
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
